APP_ENV=dev
DATABASE_URL=mysql+pymysql://pos:pos-local-password@localhost:3306/pos?charset=utf8mb4
# Azure Database for MySQL の例（パスワードの記号は URL エンコードする。例: @ → %40）
# DATABASE_URL=mysql+pymysql://<ユーザー名>:<パスワード>@<サーバー名>.mysql.database.azure.com:3306/<データベース名>?charset=utf8mb4
# DB_SSL=true
DB_SSL=false
CORS_ORIGINS=http://localhost:3000
# 本番では十分に長いランダム値にする（例: python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=15
TAX_ROUNDING=floor
# テストやデモで業務日付を固定したいときだけ指定（例: 2026-09-05）
# BUSINESS_DATE=
